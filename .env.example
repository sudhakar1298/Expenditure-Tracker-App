# ============================================================
# GPAY EXPENSE TRACKER - ENVIRONMENT CONFIGURATION
# ============================================================

# Backend API Configuration
PROJECT_NAME="GPay Expense Tracker API"
API_V1_STR="/api/v1"
HOST=0.0.0.0
PORT=8000

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=expense_tracker
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expense_tracker
USE_SQLITE_FALLBACK=true

# Next.js Web Dashboard Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Databricks Pipeline Configuration
API_SOURCE_URL=http://localhost:8000/api/v1/expenses/
DATABRICKS_DATA_DIR=./delta_lake_data
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=replace-with-your-databricks-token
DATABRICKS_WAREHOUSE_ID=replace-with-your-warehouse-id
DATABRICKS_CATALOG=replace-with-your-catalog
DATABRICKS_SCHEMA=expense_tracker_dw
