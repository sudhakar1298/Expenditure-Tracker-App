DATABRICKS_SYNC_ENABLED=false
# Workspace origin, e.g. https://<workspace>.cloud.databricks.com
DATABRICKS_HOST=
# Paste the PAT locally; do not commit this value.
DATABRICKS_TOKEN=
# SQL Warehouses > your warehouse > Connection details > warehouse ID
DATABRICKS_WAREHOUSE_ID=
# Catalog containing expense_tracker_dw (check Catalog Explorer).
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=expense_tracker_dw
DATABRICKS_SYNC_INTERVAL_SECONDS=15
API_SOURCE_URL=http://127.0.0.1:8000/api/v1/expenses/
DATABRICKS_DATA_DIR=./delta_lake_data
