PROJECT_NAME="GPay Expense Tracker API"
API_V1_STR="/api/v1"
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=expense_tracker
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expense_tracker
USE_SQLITE_FALLBACK=true

# The hosted API writes to Databricks in the background. Keep these secrets in
# Render's Environment page; never put the token in the Android application.
DATABRICKS_SYNC_ENABLED=false
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=
DATABRICKS_SCHEMA=expense_tracker_dw
DATABRICKS_SYNC_INTERVAL_SECONDS=15

# Pair one Android installation to the API. Start with enforcement disabled,
# pair the phone using the secret code, then change DEVICE_AUTH_ENABLED to true.
DEVICE_AUTH_ENABLED=false
DEVICE_PAIRING_CODE=replace-with-at-least-24-random-characters
DEVICE_SIGNATURE_MAX_AGE_SECONDS=300
